PORT=8787
# Primary frontend origin. Production CORS also allows https://the-poles.com,
# https://www.the-poles.com, and Vercel preview origins.
FRONTEND_ORIGIN=http://localhost:5173

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OWNER_EMAIL=

# Development-only local auth fallback. Leave false/blank outside local dev.
ENABLE_DEMO_AUTH=

# Product search provider credentials. Keep these backend-only.
PRODUCT_SEARCH_PROVIDER=
# eBay Browse API. Used for live North Pole prize/product search when set.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production
EBAY_MARKETPLACE_ID=EBAY_US
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
WALMART_API_KEY=

# Prize fulfillment launch mode. Mock simulates order IDs/tracking and never spends money.
FULFILLMENT_PROVIDER=mock
FULFILLMENT_MODE=ai_assisted
MOCK_FULFILLMENT_DELIVERY_DAYS=7

# Game search provider credentials. Keep these backend-only.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# RAWG API. Used for live North Pole game search when set.
RAWG_API_KEY=
STEAM_API_KEY=

# Stripe mission-support intake. Use test keys only until processor approval and legal review are complete.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
