{
  "name": "MatchScore",
  "type": "object",
  "properties": {
    "matchId": { "type": "string" },
    "userId": { "type": "string" },
    "score": { "type": "number" },
    "scoreType": {
      "type": "string",
      "enum": ["highest_score", "lowest_time", "bracket_result", "manual_review", "manual"],
      "default": "highest_score"
    },
    "evidenceUrl": { "type": "string" },
    "evidenceNotes": { "type": "string" },
    "verificationStatus": {
      "type": "string",
      "enum": ["pending", "verified", "rejected", "disputed"],
      "default": "pending"
    },
    "aiReviewStatus": {
      "type": "string",
      "enum": ["not_reviewed", "clean", "suspicious", "flagged"],
      "default": "not_reviewed"
    },
    "platformUsername": { "type": "string" },
    "matchRound": { "type": "string" },
    "metadata": { "type": "object", "default": {} },
    "reviewNotes": { "type": "string" },
    "reviewedBy": { "type": "string" },
    "reviewedAt": { "type": "string" }
  },
  "required": ["matchId", "userId", "score", "scoreType", "verificationStatus", "aiReviewStatus"]
}
