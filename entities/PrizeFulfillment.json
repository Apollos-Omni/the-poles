{
  "name": "PrizeFulfillment",
  "type": "object",
  "properties": {
    "match_id": { "type": "string" },
    "winner_id": { "type": "string" },
    "winner_name": { "type": "string" },
    "winner_email": { "type": "string" },
    "prize_title": { "type": "string" },
    "prize_url": { "type": "string" },
    "prize_image": { "type": "string" },
    "prize_source": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "pending_address",
        "ready_to_order",
        "ordered",
        "shipped",
        "delivered",
        "cancelled",
        "pending_verification",
        "pending_admin_approval"
      ],
      "default": "pending_address"
    },
    "shipping_status": {
      "type": "string",
      "enum": [
        "pending_address",
        "ready_to_order",
        "ordered",
        "shipped",
        "delivered",
        "cancelled",
        "pending_verification",
        "pending_admin_approval"
      ],
      "default": "pending_address"
    },
    "admin_approved": { "type": "boolean", "default": false },
    "shipping_name": { "type": "string" },
    "shipping_address_line1": { "type": "string" },
    "shipping_address_line2": { "type": "string" },
    "shipping_city": { "type": "string" },
    "shipping_state": { "type": "string" },
    "shipping_zip": { "type": "string" },
    "shipping_country": { "type": "string" },
    "retailer_order_id": { "type": "string" },
    "tracking_number": { "type": "string" },
    "provider": { "type": "string" },
    "provider_status": { "type": "string" },
    "provider_reference": { "type": "string" },
    "fulfillment_mode": { "type": "string" },
    "prize_cost_breakdown": { "type": "object" },
    "item_cost_cents": { "type": "number" },
    "estimated_tax_cents": { "type": "number" },
    "estimated_shipping_cents": { "type": "number" },
    "fulfillment_reserve_cents": { "type": "number" },
    "platform_or_foundation_amount_cents": { "type": "number" },
    "total_required_cents": { "type": "number" },
    "estimated_delivery": { "type": "string" },
    "demo_mode": { "type": "boolean", "default": false },
    "test_order": { "type": "boolean", "default": false },
    "reviewed_at": { "type": "string" },
    "reviewed_by": { "type": "string" },
    "order_prepared_at": { "type": "string" },
    "ordered_at": { "type": "string" },
    "admin_notes": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "required": [
    "match_id",
    "winner_id",
    "prize_title",
    "status",
    "shipping_status",
    "admin_approved"
  ]
}
