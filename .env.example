# Frontend-safe configuration.
VITE_API_BASE_URL=http://localhost:8787
VITE_AUTH_MODE=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Only VITE_ variables belong in the frontend environment.
# Backend payment credentials are read by the backend from the project-root .env or host environment.
PUBLIC_APP_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Stripe payment collection / creator payout scaffolding.
# Start with TEST keys only. Do not add live keys until legal/accounting review is complete.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
STRIPE_CONNECT_COUNTRY=US

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production
EBAY_MARKETPLACE_ID=EBAY_US
FULFILLMENT_PROVIDER=mock
FULFILLMENT_MODE=ai_assisted
