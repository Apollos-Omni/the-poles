# Frontend-safe configuration.
VITE_API_BASE_URL=http://localhost:8787
VITE_AUTH_MODE=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Only VITE_ variables belong in the frontend environment.
# Backend secrets are read by the backend from the project-root .env or host environment.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production
EBAY_MARKETPLACE_ID=EBAY_US
